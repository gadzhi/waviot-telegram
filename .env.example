# Copy to .env locally. Never paste the real key into chat or Git.
WAVIOT_API_KEY=
# Optional for first discovery; required to check an expected house scope.
WAVIOT_HOUSE_ID=
# Optional display name; avoid personal data in this label.
WAVIOT_HOUSE_LABEL=Подключённый дом
# Minimum pause between read-only requests; no automatic retries.
WAVIOT_REQUEST_INTERVAL_SECONDS=1
WAVIOT_TIMEOUT_SECONDS=30

# Local Telegram bot. Never put this token into chat or Git.
TELEGRAM_BOT_TOKEN=
BOT_DATABASE=artifacts/runtime/state.sqlite3
BOT_TIMEZONE=Europe/Moscow
# Disabled until the consumption API contract is confirmed.
BOT_LIVE_ALERTS=false

# Web admin. Public HTTPS is enabled by compose.public.yaml on the server.
ADMIN_PUBLIC=false
ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ADMIN_CSRF_ORIGINS=
# Native reverse proxy only: its exact IP or DNS name. Compose sets "proxy".
# Forwarded client IPs are ignored unless ADMIN_PUBLIC=true and the peer matches.
# ADMIN_TRUSTED_PROXY=
ADMIN_PORT=8000
# On the server: admin.example.org. No scheme or path.
ADMIN_DOMAIN=
# Optional native paths; Compose uses /data automatically.
# ADMIN_DATABASE=artifacts/runtime/admin.sqlite3
# ADMIN_SECRET_KEY_FILE=artifacts/runtime/admin-secret.key
# WAVIOT_SCOPE_FILE=audit-scope.json
